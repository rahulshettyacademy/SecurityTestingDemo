# RSA SecureShop - example environment file
# Copy this file to .env and adjust if needed. All values below are dummy,
# local-only training values. Do not put real secrets in this file.

# --- PostgreSQL (internal Docker network only, never published to the host) ---
POSTGRES_USER=secureshop
POSTGRES_PASSWORD=secureshop_dev_password
POSTGRES_DB=secureshop

# --- Backend ---
NODE_ENV=development
PORT=5000
DB_HOST=postgres
DB_PORT=5432
DB_USER=secureshop
DB_PASSWORD=secureshop_dev_password
DB_NAME=secureshop

# Dummy local JWT secret. Never reuse this value outside this training lab.
JWT_SECRET=rsa-secureshop-dummy-local-training-secret
JWT_EXPIRES_IN=2h

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Clearly fake key used only to demonstrate secret-scanning tools.
FAKE_DEMO_API_KEY=rsa-training-not-a-real-key

# --- Frontend ---
# 127.0.0.1 (not "localhost") avoids a common macOS issue where "localhost"
# resolves to ::1 and hits an unrelated IPv6 service (e.g. AirPlay Receiver
# also listens on port 5000). See README troubleshooting section.
VITE_API_BASE_URL=http://127.0.0.1:5000/api
